# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_chatbot
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20

# Google Gemini Configuration (backend only - never expose this key to the frontend)
# Get a free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini models (both have free-tier access; usage is subject to Google's limits)
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional generation settings
# GEMINI_MAX_TOKENS includes Gemini's thinking tokens, so keep some headroom
GEMINI_MAX_TOKENS=2048
# low | medium | high (gemini-3.8-flash cannot turn thinking off)
GEMINI_THINKING_LEVEL=low
# Bounded retries on 408/429/5xx and network errors (never retries forever)
GEMINI_MAX_RETRIES=2

# RAG Configuration
# Must match the vector(1536) column in the documents table
EMBEDDING_DIMENSION=1536
SIMILARITY_THRESHOLD=0.7
MAX_SOURCES=5